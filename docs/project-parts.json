{
  "repository_type": "monorepo",
  "workspace_manager": "bun",
  "workspaces": ["apps/*", "packages/*"],
  "parts": [
    {
      "part_id": "web",
      "display_name": "Web (Next.js cockpit)",
      "project_type_id": "web",
      "root_path": "apps/web",
      "package_name": "web",
      "entry_point": "apps/web/app/layout.tsx",
      "tech": ["Next.js 16 (canary)", "React 19", "TypeScript", "Tailwind v4", "shadcn (base-nova) on @base-ui/react", "@anthropic-ai/claude-agent-sdk", "streamdown"],
      "docs": ["architecture-web.md", "api-contracts-web.md", "data-models-web.md", "component-inventory-web.md"]
    },
    {
      "part_id": "desktop",
      "display_name": "Desktop (Electron shell)",
      "project_type_id": "desktop",
      "root_path": "apps/desktop",
      "package_name": "telar-desktop",
      "entry_point": "apps/desktop/main.js",
      "tech": ["Electron", "electron-builder"],
      "docs": ["architecture-desktop.md", "component-inventory-desktop.md", "deployment-guide.md"]
    },
    {
      "part_id": "core",
      "display_name": "Core (loom engine library)",
      "project_type_id": "library",
      "root_path": "packages/core",
      "package_name": "@telar/core",
      "entry_point": "packages/core/src/index.ts",
      "tech": ["TypeScript", "Bun", "@anthropic-ai/claude-agent-sdk", "zod", "yaml"],
      "docs": ["architecture-core.md", "data-models-web.md"]
    }
  ],
  "integration_points": [
    {
      "from": "web",
      "to": "core",
      "type": "in-process workspace import (workspace:*)",
      "details": "@telar/core runs in-process in server-side layers only (route handlers / server components). Client components are restricted to type-only imports by the CLIENT-BUNDLE RULE."
    },
    {
      "from": "desktop",
      "to": "web",
      "type": "child process + HTTP",
      "details": "The Electron shell forks the packaged Next.js standalone server and points a single BrowserWindow at it (stable persisted port, login-shell PATH capture, --smoke fail-closed gate)."
    },
    {
      "from": "core",
      "to": "Claude Agent SDK",
      "type": "external service (Anthropic)",
      "details": "Agent execution: schema-forced, capability-walled agent() invocations; deterministic control flow stays in code."
    },
    {
      "from": "core",
      "to": "MCP servers",
      "type": "MCP + OAuth 2.1",
      "details": "From-scratch MCP OAuth 2.1 client; tokens and records persisted under TELAR_HOME."
    },
    {
      "from": "verifier (core)",
      "to": "running app",
      "type": "browser automation (read-only)",
      "details": "The verifier drives the app via @playwright/mcp (packaged into the desktop bundle); it can observe but never edit code."
    },
    {
      "from": "scripts/telar",
      "to": "apps",
      "type": "CLI launcher",
      "details": "Repo tooling entry point; scripts/build-desktop.sh runs the desktop packaging pipeline with a smoke-test gate."
    }
  ]
}
