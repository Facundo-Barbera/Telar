{
  "name": "telar-desktop",
  "version": "0.1.0",
  "private": true,
  "//productName": "NAMES THE USER-DATA DIRECTORY, not just the window. Electron's app.getName() prefers this over `name`, and app.getPath('userData') is composed from it — so without it this app's state lives in ~/Library/Application Support/telar-desktop, a directory named after the shell package rather than the product. That directory is now TELAR_HOME for a packaged build (main.js), which makes the name a thing people will read.",
  "productName": "Telar",
  "description": "Telar desktop shell with a shared Electron-owned browser host.",
  "author": "Facundo Barbera <facundo.barbera@gmail.com>",
  "main": "main.js",
  "scripts": {
    "build:app": "bash ./build-app.sh",
    "dev": "bun ./dev-runner.js",
    "test": "bun run test:desktop:unit",
    "test:desktop": "bun run test:desktop:unit",
    "test:desktop:unit": "bun test ./browser-manager.test.js ./external-links.test.js ./browser-control-server.test.js ./window-chrome.test.js ./packaging.test.js ./dev-update.test.js ./extension-compat.test.js ./private-interaction.test.js ./extension-host.test.js ./browser-profiles.test.js ./browser-tab-store.test.js ./browser-suggestions.test.js",
    "test:desktop:smoke": "electron . --smoke",
    "test:desktop:e2e": "bun ./desktop-e2e-launcher.js",
    "test:desktop:browser": "env -u ELECTRON_RUN_AS_NODE electron ./browser-manager.electron-test.js",
    "test:desktop:fit-zoom": "env -u ELECTRON_RUN_AS_NODE electron ./browser-fit-zoom.electron-test.js",
    "test:desktop:persistence": "env -u ELECTRON_RUN_AS_NODE electron ./browser-persistence.electron-test.js",
    "test:desktop:profile-cookies": "env -u ELECTRON_RUN_AS_NODE electron ./browser-profile-cookies.electron-test.js",
    "test:desktop:credentials": "env -u ELECTRON_RUN_AS_NODE electron ./credential-frames.electron-test.js",
    "test:desktop:popup-geometry": "env -u ELECTRON_RUN_AS_NODE electron ./popup-geometry.electron-test.js",
    "test:desktop:extension": "env -u ELECTRON_RUN_AS_NODE electron ./extension-harness.electron-test.js",
    "test:desktop:extension-boot": "env -u ELECTRON_RUN_AS_NODE electron ./extension-boot.electron-test.js",
    "test:desktop:webauthn": "env -u ELECTRON_RUN_AS_NODE electron ./webauthn-fixture.electron-test.js",
    "smoke": "bun run test:desktop:smoke",
    "pack": "bash ../../scripts/package-desktop.sh",
    "package:local": "bash ../../scripts/package-desktop.sh",
    "package:dev": "bash ../../scripts/package-desktop.sh --dev",
    "install:app": "bash ./install-app.sh",
    "install:local": "bash ../../scripts/package-desktop.sh --install"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "com.telar.desktop",
    "productName": "Telar",
    "asar": true,
    "files": [
      "main.js",
      "browser-manager.js",
      "browser-suggestions.js",
      "browser-tab-preload.js",
      "browser-control-server.js",
      "extension-compat.js",
      "extension-host.js",
      "private-interaction.js",
      "browser-profiles.js",
      "browser-tab-store.js",
      "command-keys.js",
      "helper-exec.js",
      "dev-update.js",
      "dev-update-core.js",
      "dev-update-preload.js",
      "dev-update.html",
      "preload.js",
      "server-preload.js",
      "tailscale.js",
      "window-chrome.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/.next-desktop/standalone",
        "to": "standalone"
      },
      {
        "from": "../web/.next-desktop/standalone/node_modules/.bun",
        "to": "standalone/node_modules/.bun"
      },
      {
        "from": "../engine/dist",
        "to": "engine"
      },
      {
        "from": "../engine/dist/node_modules",
        "to": "engine/node_modules"
      },
      {
        "from": "build",
        "to": "branding",
        "filter": [
          "*.png"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "//NSAppleEventsUsageDescription": "The string macOS shows in the Automation consent dialog when Telar first drives Codex's Computer Use client. Without it the prompt cannot appear and every computer-use call fails silently with -1743.",
        "NSAppleEventsUsageDescription": "Telar uses Computer Use to control Mac apps on your behalf — taking screenshots and performing clicks and keystrokes — through Codex's Computer Use client."
      }
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.invalid/set-at-build-time"
    }
  },
  "dependencies": {
    "electron-chrome-extensions": "4.9.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
