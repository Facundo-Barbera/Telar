{
  "name": "telar-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Telar desktop shell with a shared Electron-owned browser host.",
  "author": "Facundo Barbera <facundo.barbera@gmail.com>",
  "main": "main.js",
  "scripts": {
    "build:web": "bash ./build-web.sh",
    "dev": "bun ./dev-runner.js",
    "test": "bun run test:desktop:unit",
    "test:desktop": "bun run test:desktop:unit",
    "test:desktop:unit": "bun test ./browser-manager.test.js",
    "test:desktop:smoke": "electron . --smoke",
    "test:desktop:e2e": "bun ./desktop-e2e-launcher.js",
    "smoke": "bun run test:desktop:smoke",
    "pack": "bash ../../scripts/package-desktop.sh",
    "package:local": "bash ../../scripts/package-desktop.sh",
    "install:app": "bash ./install-app.sh",
    "install:local": "bash ../../scripts/package-desktop.sh --install"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "ai.ozom.telar.desktop",
    "productName": "Telar",
    "asar": true,
    "files": [
      "main.js",
      "browser-manager.js",
      "browser-control-server.js",
      "command-keys.js",
      "preload.js",
      "server-preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web_old/.next-desktop/standalone",
        "to": "standalone"
      },
      {
        "from": "../web_old/.next-desktop/standalone/node_modules/.bun",
        "to": "standalone/node_modules/.bun"
      },
      {
        "from": "../web_old/.next-desktop/playwright-mcp/node_modules",
        "to": "playwright-mcp/node_modules"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "hardenedRuntime": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.invalid/set-at-build-time"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
