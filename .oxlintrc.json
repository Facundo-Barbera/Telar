{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "node": true,
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/test-fixtures/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/desktop/src/browser/browser-downloads.js",
        "apps/engine/src/domains/remote/routes.ts",
        "apps/engine/src/worker/diagnostics.ts"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": [
        "apps/engine/src/platform/process/daemon-lock.ts"
      ],
      "rules": {
        "no-unsafe-finally": "off"
      }
    },
    {
      "files": [
        "apps/engine/src/domains/providers/models.ts",
        "apps/engine/src/domains/providers/skills.ts",
        "apps/engine/src/drivers/claude/run.test.ts"
      ],
      "rules": {
        "require-yield": "off"
      }
    },
    {
      "files": [
        "apps/engine/src/domains/plugins/data-science/kernel-host.ts"
      ],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": [
        "apps/engine/src/domains/turns/claims.ts",
        "apps/engine/src/drivers/claude/runtime.ts",
        "apps/engine/src/platform/kernel/kernel.ts",
        "apps/engine/src/worker/worker.ts"
      ],
      "rules": {
        "unicorn/no-useless-spread": "off"
      }
    },
    {
      "files": [
        "packages/engine-client/src/platform/client.ts"
      ],
      "rules": {
        "typescript/no-unsafe-declaration-merging": "off"
      }
    }
  ]
}
