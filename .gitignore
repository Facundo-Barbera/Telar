node_modules/
.next/
.next-desktop/
# Turborepo's local task cache — regenerated per run, machine-specific.
.turbo/
.env*
!.env.example
.DS_Store
*.log
.telar/
# Playwright MCP / test output (Verifier agent — generated per run)
.playwright-mcp/
test-results/
playwright-report/

# Desktop build outputs (electron-builder output + standalone web build)
apps/desktop/release/
.next-desktop/

# Scratch Next builds from parallel agent runs. `.next/` above only covers the
# default distDir; next.config.ts's NEXT_DIST_DIR lets a run pick its own, and
# each one is ~650MB.
apps/*/.next-codex-*/
.codex-tmp/
.tmp/

# Local runtime state, not source: a TELAR_HOME-shaped tree keyed by repo path,
# and the desktop dev runner's scratch profile.
/projects/
.telar-desktop-dev/

# pnpm's content-addressed store, if a tool reaches for pnpm in this tree.
.pnpm-store/

# wrangler's local miniflare state (sqlite emulation of R2/cache), per machine.
.wrangler/

# BMAD And others
_bmad/
.claude/
.agents/
.cleanup-archives/
telar.yaml

# The packaged engine: a bundle, its Agent SDK copy and its playwright-mcp
# closure, all produced by apps/desktop/build-app.sh. Build output, never source.
apps/engine/dist/

# Telar — local state, not for sharing
.telar-worktrees/

# Xcode local state and build output (apps/ios)
apps/ios/**/xcuserdata/
apps/ios/**/project.xcworkspace/
apps/ios/DerivedData*/

# Python bytecode from the kernel bridge under apps/engine/src/ds.
__pycache__/
*.pyc
