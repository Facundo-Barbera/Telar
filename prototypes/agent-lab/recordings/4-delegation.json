      ]
    },
    { "text": "I created a worktree session for the release notes, gave it the task, and subscribed to its result." },
    { "text": "", "toolCalls": [{ "name": "sessions_status", "args": { "sessionId": "ses_1" } }] },
    {
      "text": "The release-notes session finished: its turn completed. It reports it worked on drafting the release notes for 0.4."
    }
  ],
  "fallback": { "text": "Nothing further." }
