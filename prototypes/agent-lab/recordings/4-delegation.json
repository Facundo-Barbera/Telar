{
  "name": "4-delegation",
  "steps": [
    {
      "text": "",
      "toolCalls": [
        {
          "name": "sessions_create",
          "args": { "projectId": "prj_lab", "title": "Release notes for 0.4", "envMode": "worktree" }
        }
      ]
    },
    {
      "text": "",
      "toolCalls": [
        {
          "name": "sessions_send",
