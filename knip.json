{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "workers/push-relay/worker.mjs"
      ],
      "project": [
        "scripts/**/*.{mjs,ts}",
        "workers/push-relay/**/*.mjs"
      ]
    },
    "apps/engine": {
      "entry": [
        "src/*-main.ts",
        "bench/*.ts",
        "scripts/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "bench/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@playwright/mcp"
      ],
      "ignoreIssues": {
        "src/plugins/contract.ts": [
          "types"
        ]
      }
    },
    "apps/web": {
      "project": [
        "**/*.{ts,tsx,mjs,css}"
      ],
      "entry": [
        "scripts/*.mjs",
        "public/**/*.mjs"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/preload/*.js",
        "src/**/*.electron-test.js",
        "test/electron/desktop-e2e*.js",
        "scripts/after-pack.js"
      ],
      "project": [
        "**/*.{js,mjs,cjs}"
      ],
      "ignoreDependencies": [
        "electron-builder",
        "debug"
      ]
    },
    "packages/engine-client": {
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "workers/updates-proxy": {
      "entry": [
        "src/index.js"
      ],
      "project": [
        "**/*.{js,mjs}"
      ]
    }
  },
  "ignoreBinaries": [
    "du",
    "pgrep",
    "op",
    "diskutil",
    "uv",
    "osascript",
    "scutil",
    "tailscale",
    "plutil",
    "sips",
    "rsvg-convert"
  ],
  "ignoreIssues": {
    "packages/engine-client/src/protocol/common.ts": [
      "duplicates"
    ],
    "packages/engine-client/src/protocol/entities.ts": [
      "duplicates"
    ],
    "packages/engine-client/src/protocol/plugins.ts": [
      "duplicates"
    ],
    "apps/desktop/src/{handoff/desktop-handoff-core,handoff/desktop-handoff,dev/dev-update-core,dev/dev-update,main/tailscale,main/update-watchdog,store/store-location,store/store-migrate}.js": [
      "exports"
    ],
    "apps/desktop/src/main/{ipc-app,ipc-browser,ipc-prefs,ipc-store,ipc-terminal,ui-server,updates}.js": [
      "exports"
    ],
    "apps/web/lib/remote/**": [
      "exports",
      "types"
    ],
    "apps/web/lib/mobile/**": [
      "exports",
      "types"
    ]
  }
}
